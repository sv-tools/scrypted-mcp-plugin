{
    "name": "scrypted-mcp",
    "version": "1.0.8",
    "description": "Scrypted plugin that exposes a Streamable HTTP Model Context Protocol endpoint, with OAuth backed by Scrypted user accounts. Lets AI assistants inspect logs, manage plugins, and query devices on the same Scrypted server.",
    "license": "MIT",
    "author": "Sergey Vilgelm <sergey@vilgelm.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sv-tools/scrypted-mcp-plugin.git"
    },
    "bugs": {
        "url": "https://github.com/sv-tools/scrypted-mcp-plugin/issues"
    },
    "homepage": "https://github.com/sv-tools/scrypted-mcp-plugin#readme",
    "files": [
        "dist/plugin.zip"
    ],
    "scripts": {
        "scrypted-setup-project": "scrypted-setup-project",
        "prescrypted-setup-project": "scrypted-package-json",
        "build": "scrypted-webpack",
        "prepublishOnly": "NODE_ENV=production scrypted-webpack",
        "prescrypted-vscode-launch": "scrypted-webpack",
        "scrypted-vscode-launch": "scrypted-deploy-debug",
        "scrypted-deploy-debug": "scrypted-deploy-debug",
        "scrypted-debug": "scrypted-debug",
        "scrypted-deploy": "scrypted-deploy",
        "scrypted-readme": "scrypted-readme",
        "scrypted-package-json": "scrypted-package-json",
        "fmt": "prettier --write \"src/**/*.ts\"",
        "fmt:check": "prettier --check \"src/**/*.ts\"",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix"
    },
    "keywords": [
        "scrypted",
        "scrypted-plugin",
        "plugin",
        "mcp",
        "model-context-protocol",
        "ai",
        "claude"
    ],
    "scrypted": {
        "name": "MCP Server",
        "type": "API",
        "interfaces": [
            "HttpRequestHandler",
            "Settings"
        ]
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.18.0",
        "@scrypted/sdk": "^0.5.59",
        "zod": "^4.4.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.0",
        "eslint": "^10.2.1",
        "prettier": "^3.8.3",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.59.1"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5",
        "@babel/core": "^7.29.6",
        "@hono/node-server": "^2.0.5",
        "adm-zip": "^0.6.0",
        "body-parser": "^2.3.0",
        "brace-expansion": "^5.0.8",
        "fast-uri": "^3.1.4",
        "hono": "^4.12.27"
    },
    "engines": {
        "node": ">=24"
    }
}
