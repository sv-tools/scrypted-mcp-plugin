{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "out",
        "module": "Node16",
        "target": "ES2022",
        "moduleResolution": "Node16",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true
    },
    "include": ["src/**/*"]
}
